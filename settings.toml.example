# Joomla publishing settings.
#
# Copy to `settings.toml` and fill in real values.
#   cp settings.toml.example settings.toml

[joomla]
base_url = "https://your-site.example"
base_path = "/api/index.php/v1"
# Optional. Sent verbatim as `Authorization: Basic <value>` on every
# request; omit the line if the target has no Basic Auth gate.
# base64-encoded: e.g. `printf '%s' "user:pass" | base64`
basic_auth = "replace-with-basic-auth-value"
token = "replace-with-your-api-token"
default_catid = 0
